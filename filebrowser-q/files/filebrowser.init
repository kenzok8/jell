#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

CONF="filebrowser-q"
PROG="/usr/bin/filebrowser-q"
CONF_PATH="/etc/filebrowser-q/config.yaml"
DEFAULT_DB_PATH="/etc/filebrowser-q/filebrowser.sqlite"

yaml_escape() {
	printf '%s' "$1" | tr -d '\r' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

bool_yaml() {
	if [ "$1" = "1" ]; then
		printf 'true'
	else
		printf 'false'
	fi
}

normalize_path() {
	local p
	p="$(printf '%s' "$1" | sed 's://*:/:g; s:/$::')"
	[ -z "$p" ] && p="/"
	printf '%s' "$p"
}

unique_source_name() {
	local candidate="$1"
	local final="$candidate"
	local idx=2
	while :; do
		case "$_USED_SOURCE_NAMES" in
			*"|$final|"*)
				final="${candidate}_${idx}"
				idx=$((idx + 1))
				;;
			*)
				_USED_SOURCE_NAMES="${_USED_SOURCE_NAMES}${final}|"
				printf '%s' "$final"
				return 0
				;;
		esac
	done
}

emit_root_fs_rules() {
	local indent="$1"
	local src_path="$2"
	[ "$src_path" = "/" ] || return 0
	cat <<EOF
${indent}rules:
${indent}  - folderPath: "/proc"
${indent}  - folderPath: "/sys"
${indent}  - folderPath: "/dev"
${indent}  - folderPath: "/tmp"
${indent}    viewable: true
${indent}  - folderPath: "/var"
${indent}    viewable: true
EOF
}

append_extra_source() {
	local entry="$1"
	[ -n "$entry" ] || return 0

	local src_path src_rest src_name="" src_flag="" src_ro="0"
	src_path="${entry%%:*}"
	if [ "$src_path" != "$entry" ]; then
		src_rest="${entry#*:}"
		src_name="${src_rest%%:*}"
		if [ "$src_name" != "$src_rest" ]; then
			src_flag="${src_rest#*:}"
			case "$src_flag" in
				ro|readonly) src_ro="1" ;;
			esac
		fi
	fi

	[ -n "$src_path" ] || return 0
	src_path="$(normalize_path "$src_path")"
	src_name="$(printf '%s' "$src_name" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"

	if [ -z "$src_name" ] || [ "$src_name" = "/" ]; then
		if [ "$src_path" = "/" ]; then
			src_name="root"
		else
			src_name="$(basename "$src_path")"
		fi
	fi
	src_name="$(unique_source_name "$src_name")"

	cat <<EOF >> "$TMP_CONF"
    - path: "$(yaml_escape "$src_path")"
      name: "$(yaml_escape "$src_name")"
      config:
        defaultEnabled: true
        readOnly: $(bool_yaml "$src_ro")
EOF
	emit_root_fs_rules "        " "$src_path" >> "$TMP_CONF"
}

reload_firewall() {
	[ -x /etc/init.d/firewall ] && /etc/init.d/firewall reload >/dev/null 2>&1 || true
}

start_service() {
	config_load "$CONF"

	local enabled
	config_get_bool enabled "config" "enabled" "0"
	[ "$enabled" -eq 1 ] || return 0

	local use_custom_config
	config_get_bool use_custom_config "config" "use_custom_config" "0"

	local listen_addr listen_port open_firewall base_url trust_proxy_headers
	local https_enabled tls_cert tls_key
	config_get listen_addr "config" "listen_addr" "0.0.0.0"
	config_get listen_port "config" "listen_port" "8787"
	config_get_bool open_firewall "config" "open_firewall" "0"
	config_get base_url "config" "base_url" "/"
	config_get_bool trust_proxy_headers "config" "trust_proxy_headers" "0"
	config_get_bool https_enabled "config" "https_enabled" "0"
	config_get tls_cert "config" "tls_cert" ""
	config_get tls_key "config" "tls_key" ""

	local auth_mode adminUsername adminPassword
	config_get auth_mode "config" "auth_mode" "password"
	config_get adminUsername "config" "adminUsername" "admin"
	config_get adminPassword "config" "adminPassword" ""

	local root_path db_path cacheDir cacheDirMaxSizeMB disable_previews
	config_get root_path "config" "root_path" "/"
	config_get db_path "config" "db_path" "$DEFAULT_DB_PATH"
	config_get cacheDir "config" "cacheDir" "/tmp/filebrowser-q"
	config_get cacheDirMaxSizeMB "config" "cacheDirMaxSizeMB" "300"
	config_get_bool disable_previews "config" "disable_previews" "0"

	# Guard against FileBrowser Quantum v2 forbidden 'database.db' filename
	case "$db_path" in
		*/database.db|database.db)
			db_path="$(dirname "$db_path")/filebrowser.sqlite"
			;;
	esac

	mkdir -p "$(dirname "$CONF_PATH")" "$(dirname "$db_path")" "$cacheDir"

	if [ "$use_custom_config" -eq 0 ] || [ ! -f "$CONF_PATH" ]; then
		if [ -f "$CONF_PATH" ] && grep -q 'database\.db' "$CONF_PATH" 2>/dev/null; then
			mv -f "$CONF_PATH" "$CONF_PATH.v1.bak"
		fi

		local migrate_from=""
		local legacy_db="$(dirname "$db_path")/database.db"
		if [ ! -f "$db_path" ]; then
			if [ -f "$legacy_db" ]; then
				mv -f "$legacy_db" "${legacy_db}.v1.bak"
				migrate_from="${legacy_db}.v1.bak"
			elif [ -f "${legacy_db}.v1.bak" ]; then
				migrate_from="${legacy_db}.v1.bak"
			fi
		fi

		root_path="$(normalize_path "$root_path")"
		local root_name
		if [ "$root_path" = "/" ]; then
			root_name="root"
		else
			root_name="$(basename "$root_path")"
		fi
		_USED_SOURCE_NAMES="|${root_name}|"

		[ -z "$base_url" ] && base_url="/"

		TMP_CONF="${CONF_PATH}.tmp.$$"
		: > "$TMP_CONF"
		chmod 600 "$TMP_CONF"

		cat <<EOF >> "$TMP_CONF"
http:
  listen: "$(yaml_escape "$listen_addr")"
  port: $listen_port
  baseURL: "$(yaml_escape "$base_url")"
  trustProxyHeaders: $(bool_yaml "$trust_proxy_headers")
EOF
		if [ "$https_enabled" -eq 1 ] && [ -n "$tls_cert" ] && [ -n "$tls_key" ]; then
			cat <<EOF >> "$TMP_CONF"
  tlsCert: "$(yaml_escape "$tls_cert")"
  tlsKey: "$(yaml_escape "$tls_key")"
EOF
		fi

		cat <<EOF >> "$TMP_CONF"
server:
  database:
    path: "$(yaml_escape "$db_path")"
EOF
		[ -n "$migrate_from" ] && printf '    migrateFrom: "%s"\n' "$(yaml_escape "$migrate_from")" >> "$TMP_CONF"

		cat <<EOF >> "$TMP_CONF"
  cacheDir: "$(yaml_escape "$cacheDir")"
  cacheDirMaxSizeMB: ${cacheDirMaxSizeMB:-300}
  disablePreviews: $(bool_yaml "$disable_previews")
  logging:
    - levels: "info|warning|error"
      apiLevels: "disabled"
      output: "stdout"
  sources:
    - path: "$(yaml_escape "$root_path")"
      name: "$(yaml_escape "$root_name")"
      config:
        defaultEnabled: true
EOF
		emit_root_fs_rules "        " "$root_path" >> "$TMP_CONF"
		config_list_foreach "config" "extra_sources" append_extra_source

		cat <<EOF >> "$TMP_CONF"
auth:
  methods:
EOF
		if [ "$auth_mode" = "noauth" ]; then
			cat <<EOF >> "$TMP_CONF"
    noauth: true
    password:
      enabled: false
EOF
		else
			cat <<EOF >> "$TMP_CONF"
    noauth: false
    password:
      enabled: true
      adminUsername: "$(yaml_escape "${adminUsername:-admin}")"
EOF
		fi

		cat <<EOF >> "$TMP_CONF"
userDefaults:
  ui:
    locale: "zhCN"
EOF

		mv -f "$TMP_CONF" "$CONF_PATH"
	fi

	procd_open_instance
	procd_set_param command "$PROG"
	procd_append_param command -c "$CONF_PATH"
	procd_set_param file "$CONF_PATH"

	if [ "$auth_mode" != "noauth" ] && [ -n "$adminPassword" ] && [ "$adminPassword" != "admin" ]; then
		procd_set_param env "FILEBROWSER_ADMIN_PASSWORD=$adminPassword"
	fi

	procd_set_param limits nofile="65535 65535"
	procd_set_param term_timeout 15
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5

	if [ "$open_firewall" -eq 1 ]; then
		procd_open_data
		json_add_array firewall
			json_add_object ""
			json_add_string type rule
			json_add_string name "Allow-FileBrowser-Quantum"
			json_add_string src "*"
			json_add_string dest_port "$listen_port"
			json_add_string proto "tcp"
			json_add_string target "ACCEPT"
			json_close_object
		json_close_array
		procd_close_data
	fi

	procd_close_instance
}

service_started() {
	reload_firewall
}

service_stopped() {
	reload_firewall
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}
