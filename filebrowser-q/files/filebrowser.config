config filebrowser 'config'
	option enabled '0'
	option listen_addr '0.0.0.0'
	option listen_port '8787'
	option open_firewall '0'
	option base_url '/'
	option locale 'zhCN'
	option disable_update_check '0'
	option disable_default_links '0'
	option disable_used_percentage '0'
	option disable_pwa_install '0'
	option disable_event_themes '0'
	option root_path '/'
	option read_only '0'
	option private_source '0'
	option create_user_dir '0'
	option use_logical_size '0'
	option exclude_virtual_fs '1'
	option disable_indexing '0'
	option ignore_hidden '0'
	option ignore_symlinks '0'
	option ignore_zero_size_folders '0'
	option file_mode '644'
	option dir_mode '755'
	option auth_mode 'password'
	option adminUsername 'admin'
	option adminPassword 'admin123'
	option min_password_length '5'
	option signup '0'
	option enforced_otp '0'
	option enable_passkey '0'
	option proxy_header 'X-Forwarded-User'
	option token_expiration_hours '2'
	option disable_rate_limit '0'
	option disable_webdav '0'
	option trust_proxy_headers '0'
	option https_enabled '0'
	option db_path '/etc/filebrowser-q/filebrowser.sqlite'
	option disable_auto_backup '0'
	option cacheDir '/tmp/filebrowser-q'
	option cacheDirMaxSizeMB '300'
	option cache_cleanup '0'
	option max_archive_size '20'
	option min_search_length '3'
	option search_results_limit '1000'
	option disable_previews '0'
	option disable_preview_resize '0'
	option disable_type_detection '0'
	option startup_integrity_check 'quickCheck'
	option index_cache_size_mb '32'
	option index_wal_mode '0'
	option extract_subtitles '0'
	option heic_preview '0'
	option onlyoffice_enabled '0'
	option onlyoffice_view_only '0'
	option log_level 'info|warning|error'
	option api_log '0'
	option use_custom_config '0'
	option custom_config_path '/etc/filebrowser-q/config.yaml'
