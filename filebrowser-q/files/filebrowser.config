config filebrowser 'config'
	option enabled '0'
	option listen_addr '0.0.0.0'
	option listen_port '8787'
	option open_firewall '0'
	option auth_mode 'password'
	option adminUsername 'admin'
	option adminPassword 'admin123'
	option root_path '/'
	option db_path '/etc/filebrowser-q/filebrowser.sqlite'
	option cacheDir '/tmp/filebrowser-q'
	option cacheDirMaxSizeMB '300'
	option disable_previews '0'
	option base_url '/'
	option trust_proxy_headers '0'
	option https_enabled '0'
	option use_custom_config '0'
