#!/bin/sh /etc/rc.common

USE_PROCD=1
START=18
STOP=51

PROG=/usr/bin/hickory-dns
CONF_DIR=/etc/hickory-dns
CONF_STATIC=$CONF_DIR/forwarder.toml
RUN_DIR=/var/run/hickory-dns
CONF_GEN=$RUN_DIR/forwarder.toml
NEIGH_ARGS=$RUN_DIR/ipv6-neigh.args
TSIG_KEY=$CONF_DIR/update.key
TSIG_NAME=update-key.
ZONE=lan

RUN_USER=nobody
RUN_GROUP=nogroup

# Entries look like "3.168.192.in-addr.arpa::192.168.3.0/24".
PTR_ENTRIES=
DEV=

prepare_config_dir() {
    [ -d "$CONF_DIR" ] || mkdir -p "$CONF_DIR"

    chown -R "$RUN_USER:$RUN_GROUP" "$CONF_DIR" 2>/dev/null || true

    find "$CONF_DIR" -type d -exec chmod 755 {} \; 2>/dev/null || true
    find "$CONF_DIR" -type f -exec chmod 644 {} \; 2>/dev/null || true
}

generate_tsig_key() {
    if [ ! -f "$TSIG_KEY" ]; then
        dd if=/dev/urandom bs=32 count=1 of="$TSIG_KEY" 2>/dev/null
    fi

    chown "$RUN_USER:$RUN_GROUP" "$TSIG_KEY" 2>/dev/null || true
    chmod 400 "$TSIG_KEY" 2>/dev/null || true
}

# Reverse zone name and network CIDR for an IPv4 address/prefix.
# Only /8, /16 and /24 boundaries are supported, matching what the
# ipv6-neigh updater can derive a zone name for.
ipv4_rev() {
    local addr="$1" prefix="$2" o1 o2 o3 rest

    case "$addr" in
        *.*.*.*) ;;
        *) return 1 ;;
    esac

    o1=${addr%%.*}
    rest=${addr#*.}
    o2=${rest%%.*}
    rest=${rest#*.}
    o3=${rest%%.*}

    case "$prefix" in
        2[4-9]|3[0-2]) echo "$o3.$o2.$o1.in-addr.arpa $o1.$o2.$o3.0/$prefix" ;;
        1[6-9]|2[0-3]) echo "$o2.$o1.in-addr.arpa $o1.$o2.0.0/$prefix" ;;
        [8-9]|1[0-5])  echo "$o1.in-addr.arpa $o1.0.0.0/$prefix" ;;
    esac
}

add_ptr() {
    local zone="$1" cidr="$2" entry

    [ -n "$zone" ] || return 0
    [ -n "$cidr" ] || return 0

    for entry in $PTR_ENTRIES; do
        [ "$entry" = "$zone::$cidr" ] && return 0
    done

    PTR_ENTRIES="$PTR_ENTRIES $zone::$cidr"
    return 0
}

# Resolve the configured netifd interface into the device name that
# ipv6-neigh publishes the router's own addresses from.
#
# hickory-dns is started before netifd, so the interface may not have
# addresses yet; poll briefly instead of falling back to no reverse zones
# on every boot.
resolve_lan() {
    local iface="$1" st addr mask pair i tries up

    [ -n "$iface" ] || return 1

    tries=10
    i=0
    while [ "$i" -lt "$tries" ]; do
        st=$(ubus call "network.interface.$iface" status 2>/dev/null)
        if [ -n "$st" ]; then
            addr=$(printf '%s' "$st" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
            [ -n "$addr" ] && break

            # Interface is up but has no IPv4 address; waiting will not help.
            up=$(printf '%s' "$st" | jsonfilter -e '@.up' 2>/dev/null)
            [ "$up" = "true" ] && break
        fi

        i=$((i + 1))
        [ "$i" -lt "$tries" ] && sleep 1
    done

    [ -n "$st" ] || return 1

    DEV=$(printf '%s' "$st" | jsonfilter -e '@.l3_device' 2>/dev/null)
}

# One reverse zone per IPv4 address on every interface that is not loopback and
# does not carry the default route, so a fresh install covers all local
# networks without listing them in /etc/config/hickory-dns.
resolve_reverse_zones() {
    local names name st dev targets addr mask pair i

    names=$(ubus call network.interface dump 2>/dev/null | jsonfilter -e '@.interface[*].interface' 2>/dev/null)
    [ -n "$names" ] || return 0

    for name in $names; do
        st=$(ubus call "network.interface.$name" status 2>/dev/null)
        [ -n "$st" ] || continue

        dev=$(printf '%s' "$st" | jsonfilter -e '@.l3_device' 2>/dev/null)
        [ -n "$dev" ] || continue
        [ "$dev" = "lo" ] && continue

        # The WAN side carries the default route; its address is not ours to serve.
        targets=" $(printf '%s' "$st" | jsonfilter -e '@.route[*].target' 2>/dev/null | tr '\n' ' ') "
        case "$targets" in
            *" 0.0.0.0 "*) continue ;;
        esac

        i=0
        while :; do
            addr=$(printf '%s' "$st" | jsonfilter -e "@[\"ipv4-address\"][$i].address" 2>/dev/null)
            [ -n "$addr" ] || break
            mask=$(printf '%s' "$st" | jsonfilter -e "@[\"ipv4-address\"][$i].mask" 2>/dev/null)
            case "$addr" in
                127.*|169.254.*) ;;
                *)
                    pair=$(ipv4_rev "$addr" "$mask")
                    add_ptr "${pair%% *}" "${pair#* }"
                    ;;
            esac
            i=$((i + 1))
        done
    done
}

# Prefix-local zones stay static; only the LAN reverse zones are generated.
render_config() {
    local entry zone

    mkdir -p "$RUN_DIR" || return 1

    {
        cat "$CONF_STATIC" || return 1

        for entry in $PTR_ENTRIES; do
            zone=${entry%%::*}
            cat <<EOF

[[zones]]
zone = "$zone"
axfr_policy = "AllowAll"

[zones.stores]
type = "sqlite"
zone_path = "$CONF_DIR/empty.zone"
journal_path = ":memory:"
allow_update = true

[[zones.stores.tsig_keys]]
name = "$TSIG_NAME"
key_file = "$TSIG_KEY"
algorithm = "hmac-sha256"
fudge = 300
EOF
        done
    } > "$CONF_GEN.tmp" || return 1

    mv "$CONF_GEN.tmp" "$CONF_GEN"
}

write_neigh_args() {
    local entry

    {
        echo "--private-subnet-v4"
        echo "-d"
        echo "[::1]:53"
        echo "-z"
        echo "$ZONE"
        echo "--router-alias"
        echo "router"
        echo "--router-alias"
        echo "ns"
        echo "--zone-apex"
        echo "--keepalive-gua"

        for entry in $PTR_ENTRIES; do
            echo "--ptr-ipv4-subnet"
            echo "${entry#*::}"
        done

        echo "--ptr-ula"

        if [ -n "$DEV" ]; then
            echo "--router-iface"
            echo "$DEV"
        fi
    } > "$NEIGH_ARGS.tmp"

    mv "$NEIGH_ARGS.tmp" "$NEIGH_ARGS"
}

start_service() {
    local enabled iface subnets conf sn addr prefix pair

    config_load hickory-dns
    config_get_bool enabled main enabled 1
    [ "$enabled" = "1" ] || return 0
    config_get iface main iface lan
    config_get subnets main subnet

    prepare_config_dir
    generate_tsig_key

    PTR_ENTRIES=
    DEV=

    resolve_lan "$iface"
    resolve_reverse_zones

    for sn in $subnets; do
        addr=${sn%%/*}
        prefix=${sn#*/}
        [ "$prefix" = "$sn" ] && prefix=32

        pair=$(ipv4_rev "$addr" "$prefix")
        add_ptr "${pair%% *}" "${pair#* }"
    done

    conf=$CONF_GEN
    if ! render_config; then
        logger -t hickory-dns "failed to render config, using static config"
        conf=$CONF_STATIC
    elif ! "$PROG" --validate -c "$CONF_GEN" -q; then
        logger -t hickory-dns "generated config failed validation, using static config"
        conf=$CONF_STATIC
    fi

    write_neigh_args

    chmod 644 "$conf" "$NEIGH_ARGS" 2>/dev/null || true

    procd_open_instance hickory-dns
    procd_set_param command "$PROG" -c "$conf" -q
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn "${respawn_threshold:-3600}" "${respawn_timeout:-5}" "${respawn_retry:-5}"
    procd_close_instance hickory-dns

    procd_open_instance ipv6-neigh
    procd_set_param command /usr/bin/ipv6-neigh-wrapper
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn "${respawn_threshold:-3600}" "${respawn_timeout:-5}" "${respawn_retry:-5}"
    procd_close_instance ipv6-neigh
}
