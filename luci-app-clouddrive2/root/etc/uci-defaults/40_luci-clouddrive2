#!/bin/sh

uci -q batch <<-EOF >/dev/null
	set clouddrive2.main=clouddrive2
	delete clouddrive2.main.https_enabled
	delete clouddrive2.main.https_port
	delete clouddrive2.main.shared_mount
	delete clouddrive2.main.allow_other
	delete clouddrive2.main.startup_delay
	delete clouddrive2.main.max_open_files
	delete clouddrive2.main.proxy
	delete clouddrive2.main.enable_run_after_start
	delete clouddrive2.main.run_after_start
	delete clouddrive2.main.log_stdout
	delete clouddrive2.main.log_stderr
	delete clouddrive2.main.extra_env
	commit clouddrive2
EOF

for kv in \
	"enabled=0" \
	"port=19798" \
	"open_firewall=0" \
	"config_dir=/etc/clouddrive2" \
	"mount_point=/mnt/clouddrive" \
	"cache_dir=/tmp/clouddrive2"
do
	key="${kv%%=*}"
	val="${kv#*=}"
	if [ -z "$(uci -q get clouddrive2.main.$key)" ]; then
		uci -q set "clouddrive2.main.$key=$val"
	fi
done
uci -q commit clouddrive2

rm -rf /tmp/luci-indexcache* /tmp/luci-modulecache/ 2>/dev/null

if [ -z "$IPKG_INSTROOT" ] && [ -x /etc/init.d/rpcd ]; then
	/etc/init.d/rpcd reload >/dev/null 2>&1 || true
fi

exit 0
