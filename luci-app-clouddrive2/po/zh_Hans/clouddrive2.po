msgid ""
msgstr ""
"Language: zh_Hans\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "NAS"
msgstr "网络存储"

msgid "CloudDrive2"
msgstr "CloudDrive2"

msgid "Settings"
msgstr "基本设置"

msgid "Log"
msgstr "运行日志"

msgid "Grant UCI, service, and helper access for luci-app-clouddrive2"
msgstr "授予 luci-app-clouddrive2 的 UCI、服务控制及辅助脚本访问权限"

msgid "Path cannot be empty"
msgstr "路径不能为空"

msgid "Please enter an absolute path starting with /"
msgstr "请输入以 / 开头的绝对路径"

msgid "PID: %d"
msgstr "进程 PID: %d"

msgid "Memory: %s MB"
msgstr "内存占用: %s MB"

msgid "Active Mounts: %d"
msgstr "活动挂载数: %d"

msgid "Service action failed: %s"
msgstr "服务操作失败: %s"

msgid "Failed to execute service command: %s"
msgstr "执行服务命令失败: %s"

msgid "Open Web Interface"
msgstr "打开管理界面"

msgid "Restart"
msgstr "重启"

msgid "Stop"
msgstr "停止"

msgid "Start"
msgstr "启动"

msgid "RUNNING"
msgstr "运行中"

msgid "NOT RUNNING"
msgstr "未运行"

msgid "Web Console"
msgstr "管理后台"

msgid "Mounted Paths"
msgstr "已挂载路径"

msgid "Core binary /usr/share/clouddrive2/clouddrive was not found."
msgstr "未找到核心程序 /usr/share/clouddrive2/clouddrive。"

msgid "Warning: /dev/fuse device was not detected. Install kmod-fuse for local cloud mounting."
msgstr "警告：未检测到 /dev/fuse 设备，本地云盘挂载需要安装 kmod-fuse。"

msgid "CloudDrive2 is a multi-cloud storage management tool supporting local FUSE mounting, cross-cloud backup, and WebDAV service."
msgstr "CloudDrive2 是一款多云盘管理与挂载工具，支持通过 FUSE 将网盘挂载为本地磁盘、跨云复制备份与 WebDAV 服务。"

msgid "Enable"
msgstr "启用"

msgid "Port"
msgstr "监听端口"

msgid "Default HTTP port for Web UI and WebDAV is 19798."
msgstr "Web 管理界面与 WebDAV 的默认 HTTP 端口为 19798。"

msgid "Open Firewall Port"
msgstr "开放防火墙端口"

msgid "Allow external WAN access to the CloudDrive2 port."
msgstr "允许从外网（WAN）访问 CloudDrive2 端口。"

msgid "Configuration Directory"
msgstr "配置目录"

msgid "Stores configuration, account database, directory cache, and logs (CLOUDDRIVE_HOME)."
msgstr "存放配置文件、账号数据、目录缓存及日志（CLOUDDRIVE_HOME），闪存较小时建议改到外置存储。"

msgid "Mount Point"
msgstr "挂载目录"

msgid "Local base directory for FUSE cloud mounts."
msgstr "本地 FUSE 云盘挂载主目录，停止服务时自动卸载其下所有挂载点。"

msgid "Cache Directory"
msgstr "缓存目录"

msgid "Temporary staging directory for uploads and downloads. Use /tmp or an external disk to reduce flash wear."
msgstr "上传与下载临时缓冲目录，建议使用 /tmp 或外置磁盘以减少闪存磨损。"

msgid "Log File: %s (%s)"
msgstr "日志文件: %s（%s）"

msgid "No application log file found in %s, showing syslog output"
msgstr "在 %s 下暂未找到应用日志文件，当前显示系统日志输出"

msgid "Source: OpenWrt logread (clouddrive)"
msgstr "日志来源: OpenWrt 系统日志 logread (clouddrive)"

msgid "No log entries found."
msgstr "暂无匹配的日志记录。"

msgid "Application Log"
msgstr "应用日志"

msgid "System Log (syslog)"
msgstr "系统日志 (syslog)"

msgid "All Levels"
msgstr "全部级别"

msgid "100 Lines"
msgstr "100 行"

msgid "200 Lines"
msgstr "200 行"

msgid "500 Lines"
msgstr "500 行"

msgid "1000 Lines"
msgstr "1000 行"

msgid "Filter by keyword..."
msgstr "输入关键字筛选..."

msgid "Refresh"
msgstr "立即刷新"

msgid "Download Log"
msgstr "下载日志"

msgid "Are you sure you want to clear CloudDrive2 application log files?"
msgstr "确定要清空 CloudDrive2 应用日志文件吗？"

msgid "Application log files have been cleared."
msgstr "应用日志文件已清空。"

msgid "Failed to clear logs: %s"
msgstr "清空日志失败: %s"

msgid "Clear Log"
msgstr "清空日志"

msgid "CloudDrive2 Logs"
msgstr "CloudDrive2 运行日志"

msgid "View real-time CloudDrive2 application logs and OpenWrt procd system logs."
msgstr "实时查看 CloudDrive2 应用日志文件与 OpenWrt procd 系统运行日志。"

msgid "Newest First"
msgstr "最新日志置顶"

msgid "Auto Refresh"
msgstr "自动刷新"
